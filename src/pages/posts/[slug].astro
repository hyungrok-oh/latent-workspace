---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Latent Workspace`} description={post.data.description}>
  <article class="article-shell">
    <header class="article-header">
      <p class="eyebrow">{post.data.track}</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <dl>
        <div>
          <dt>Paper</dt>
          <dd>{post.data.paper}</dd>
        </div>
        <div>
          <dt>Format</dt>
          <dd>{post.data.format.replaceAll("-", " ")}</dd>
        </div>
        <div>
          <dt>Study status</dt>
          <dd>{post.data.status}</dd>
        </div>
        {
          post.data.updated && (
            <div>
              <dt>Updated</dt>
              <dd>{post.data.updated.toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" })}</dd>
            </div>
          )
        }
        {
          post.data.sourceUrl && (
            <div>
              <dt>Source</dt>
              <dd>
                <a href={post.data.sourceUrl}>Original paper</a>
              </dd>
            </div>
          )
        }
        {
          post.data.codeUrl && (
            <div>
              <dt>Code</dt>
              <dd>
                <a href={post.data.codeUrl}>Repository</a>
              </dd>
            </div>
          )
        }
      </dl>
      <div class="tag-list" aria-label="Tags">
        {post.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
